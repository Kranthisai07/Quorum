# Normalise to LF in the repository. Without this, a Windows checkout commits
# CRLF into scripts/bootstrap.sh, and cloning on Linux fails with
# "bad interpreter: /usr/bin/env bash^M".
* text=auto eol=lf

# PowerShell stays CRLF on disk, where it belongs.
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Never touch these.
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.zip binary
