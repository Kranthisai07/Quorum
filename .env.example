# ---------------------------------------------------------------------------
# Quorum configuration. Copy to .env and edit. Never commit .env.
# ---------------------------------------------------------------------------

# --- Deployment profile -----------------------------------------------------
# local = local CockroachDB + local process runner + local filesystem artifacts
# cloud = CockroachDB Cloud + Lambda workers + S3 artifacts
QUORUM_PROFILE=local

# --- CockroachDB ------------------------------------------------------------
# Local insecure single node (created by `quorum db up`):
QUORUM_DB_URL=postgresql://root@127.0.0.1:26257/quorum?sslmode=disable
# CockroachDB Cloud example (do not commit real credentials):
# QUORUM_DB_URL=postgresql://USER:PASSWORD@CLUSTER.cockroachlabs.cloud:26257/quorum?sslmode=verify-full

# --- Agent reasoning (Amazon Bedrock) ---------------------------------------
# stub   = deterministic offline fake, used by tests and Phase 2
# bedrock = real Amazon Bedrock calls
QUORUM_LLM_BACKEND=stub
AWS_REGION=us-east-1
# Bedrock model IDs carry an `anthropic.` prefix (Messages-API/Mantle endpoint).
QUORUM_BEDROCK_TEXT_MODEL=anthropic.claude-opus-5
QUORUM_BEDROCK_EMBED_MODEL=amazon.titan-embed-text-v2:0
# Must match the VECTOR(n) column width in the migrations.
QUORUM_EMBED_DIM=1024

# --- Artifact storage -------------------------------------------------------
# local | s3
QUORUM_ARTIFACT_BACKEND=local
QUORUM_ARTIFACT_DIR=./artifacts
# QUORUM_S3_BUCKET=quorum-artifacts

# --- Worker runner ----------------------------------------------------------
# local | lambda
QUORUM_RUNNER=local
# QUORUM_LAMBDA_FUNCTION=quorum-agent-worker

# --- Coordination tuning ----------------------------------------------------
QUORUM_CLAIM_LEASE_SECONDS=30
QUORUM_HEARTBEAT_SECONDS=10
QUORUM_TXN_MAX_RETRIES=8
# Cosine similarity above which two decisions in the same scope are considered
# near-neighbours worth classifying with an LLM.
QUORUM_SEMANTIC_THRESHOLD=0.82

# --- Logging ----------------------------------------------------------------
QUORUM_LOG_LEVEL=INFO
# json | console
QUORUM_LOG_FORMAT=json
